# Postgres connection string. This project uses @payloadcms/db-postgres.
DATABASE_URL=postgres://user:password@localhost:5432/blogs_management

# Long random string used to sign Payload auth tokens.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of this CMS, used to build admin links in outgoing emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend).
RESEND_API_KEY=
EMAIL_USER=

# Cloudinary media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Public marketing site that renders the blog. Set both of these to enable
# on-demand revalidation: when a post changes the CMS calls
# `${PUBLIC_SITE_URL}/api/revalidate` so the change appears immediately.
# REVALIDATE_SECRET must match the value set on the public site.
PUBLIC_SITE_URL=https://www.iggaxion.ai
REVALIDATE_SECRET=
# Same public site URL, exposed to the browser so admin "View live blog" links
# point at the real site. Without it those links fall back to the CMS's own
# /blog preview route and are labelled "Preview" instead of "View live".
NEXT_PUBLIC_PUBLIC_SITE_URL=https://www.iggaxion.ai
